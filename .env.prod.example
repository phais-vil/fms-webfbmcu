# ══════════════════════════════════════════════════════════════════
# FMS Production Environment Configuration (.env.prod)
# คัดลอกไฟล์นี้เป็น .env.prod แล้วแก้ไขค่าให้เป็นความลับเฉพาะเครื่อง Production
# ══════════════════════════════════════════════════════════════════

# Database Credentials
POSTGRES_USER=fms_admin
# แนะนำให้ใช้รหัสผ่านที่ซับซ้อน (ตัวอย่างสร้างด้วย openssl rand -hex 16)
POSTGRES_PASSWORD=replace-with-a-secure-db-password
POSTGRES_DB=fms_prod

# NextAuth Secret: ต้องมีความยาวอย่างน้อย 32 ตัวอักษร (สร้างด้วย: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-very-secure-32-byte-base64-secret

# Production Base URL (เช่น https://fms.example.com หรือ http://localhost:3010 กรณีทดสอบในเครื่อง)
APP_URL=http://localhost:3010

# บัญชี Super Admin สำหรับเริ่มต้นระบบ (ครั้งแรกจะสร้างให้อัตโนมัติและบังคับเปลี่ยนรหัสผ่านเมื่อเข้าสู่ระบบ)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-secure-admin-password-12chars

# Email Configuration (SMTP) - หากยังไม่ใช้งาน ให้เว้นว่างไว้ ระบบจะเขียน log แทน
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FMS System <no-reply@example.com>

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
